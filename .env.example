# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── FastRouter (LLM / Embeddings / STT / TTS) ────────────────────────
FASTROUTER_API_KEY=your-fastrouter-api-key
FASTROUTER_BASE_URL=https://go.fastrouter.ai/api/v1
FASTROUTER_CHAT_MODEL=google/gemini-3.1-pro-preview
FASTROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
FASTROUTER_MAX_RETRIES=3
FASTROUTER_TIMEOUT=30

# ── Pinecone (Vector DB for RAG) ─────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=palm-fyp
PINECONE_ENVIRONMENT=us-east-1

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production

# ── LangSmith Tracing (optional) ─────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_PROJECT=PALM
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
